{
  "name": "umlay",
  "version": "0.0.0",
  "private": true,
  "description": "Umlay — UML, relaid. DSL specification, samples, and developer/AI skill definitions for modern UML / ER diagrams.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/umlay/umlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/umlay/umlay.git"
  },
  "bugs": {
    "url": "https://github.com/umlay/umlay/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "tree-sitter-cli"]
  }
}
