        },
        {
          "id": "audit",
          "label": "AuditLog",
          "ref": "AuditLog"
        }
      ],
      "messages": [],
      "sequenceBody": {
        "participants": [
          {
            "id": "c",
            "label": "Client",
            "ref": "Client"
          },
          {
            "id": "api",
            "label": "API",
            "ref": "API"
          },
          {
            "id": "lock",
            "label": "Lock",
            "ref": "Lock"
          },
          {
            "id": "db",
            "label": "DB",
            "ref": "DB"
          },
          {
            "id": "gw",
            "label": "Gateway",
            "ref": "Gateway"
          },
          {
            "id": "audit",
            "label": "AuditLog",
            "ref": "AuditLog"
          }
        ],
        "statements": [
          {
            "kind": "message",
            "from": "c",
            "to": "api",
            "arrow": "sync",
            "label": "POST /payments"
          },
          {
            "kind": "message",
            "from": "api",
            "to": "lock",
            "arrow": "sync",
            "label": "acquire(\\\"payment:{paymentId}\\\")"
          },
          {
            "kind": "message",
            "from": "lock",
            "to": "api",
            "arrow": "reply",
            "label": "acquired"
          },
          {
            "kind": "critical",
            "label": "Gateway 決済処理",
            "timeout": {
              "duration": "5s"
            },
            "on": [
              "gw",
              "db"
            ],
            "body": [
              {
                "kind": "message",
                "from": "api",
                "to": "gw",
                "arrow": "sync",
                "label": "charge(paymentId, amount)"
              },
              {
                "kind": "message",
                "from": "gw",
                "to": "api",
                "arrow": "reply",
                "label": "{ authCode }"
              },
              {
                "kind": "message",
                "from": "api",
                "to": "db",
                "arrow": "sync",
                "label": "insert Payment (status=COMMITTED)"
              },
              {
                "kind": "message",
                "from": "db",
                "to": "api",
                "arrow": "reply",
                "label": "ok"
              }
            ],
            "catchBlock": {
              "label": "timeout or gateway error",
              "body": [
                {
                  "kind": "message",
                  "from": "api",
                  "to": "db",
                  "arrow": "sync",
                  "label": "insert Payment (status=TIMED_OUT)"
                },
                {
                  "kind": "message",
                  "from": "api",
                  "to": "audit",
                  "arrow": "sync",
                  "label": "log(\\\"payment timeout\\\", { paymentId })"
                },
                {
                  "kind": "message",
                  "from": "api",
                  "to": "gw",
                  "arrow": "sync",
                  "label": "cancelIfPending(paymentId)"
                }
              ]
            },
            "finallyBlock": {
              "body": [
                {
                  "kind": "message",
                  "from": "api",
                  "to": "lock",
                  "arrow": "sync",
                  "label": "release(\\\"payment:{paymentId}\\\")"
                },
                {
                  "kind": "message",
                  "from": "lock",
                  "to": "api",
                  "arrow": "reply",
                  "label": "released"
                }
              ]
            }
          },
          {
            "kind": "alt",
            "cases": [
              {
                "condition": "成功",
                "body": [
                  {
                    "kind": "message",
                    "from": "api",
                    "to": "c",
                    "arrow": "reply",
                    "label": "201 Created { paymentId, status }"
                  }
                ]
              },
              {
                "condition": "タイムアウト",
                "body": [
                  {
                    "kind": "message",
                    "from": "api",
                    "to": "c",
                    "arrow": "reply",
                    "label": "504 Gateway Timeout { paymentId, status: \\\"TIMED_OUT\\\" }"
                  }
                ]
              }
            ],
            "elseBody": [
              {
                "kind": "message",
                "from": "api",
                "to": "c",
                "arrow": "reply",
                "label": "500 Internal Server Error"
              }
            ]
          }
        ]
      },
