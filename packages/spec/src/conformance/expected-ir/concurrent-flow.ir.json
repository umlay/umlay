      "sequenceBody": {
        "participants": [
          {
            "id": "c",
            "label": "Client",
            "ref": "Client"
          },
          {
            "id": "api",
            "label": "API",
            "ref": "API"
          },
          {
            "id": "db",
            "label": "DB",
            "ref": "DB"
          },
          {
            "id": "cache",
            "label": "CacheSvc",
            "ref": "CacheSvc"
          },
          {
            "id": "queue",
            "label": "QueueSvc",
            "ref": "QueueSvc"
          },
          {
            "id": "analytics",
            "label": "AnalyticsSvc",
            "ref": "AnalyticsSvc"
          },
          {
            "id": "email",
            "label": "EmailSvc",
            "ref": "EmailSvc"
          }
        ],
        "statements": [
          {
            "kind": "message",
            "from": "c",
            "to": "api",
            "arrow": "sync",
            "label": "POST /orders (userId, items[])"
          },
          {
            "kind": "message",
            "from": "api",
            "to": "db",
            "arrow": "sync",
            "label": "insert Order (status=DRAFT)"
          },
          {
            "kind": "message",
            "from": "db",
            "to": "api",
            "arrow": "reply",
            "label": "Order { id }"
          },
          {
            "kind": "par",
            "branches": [
              {
                "label": "cache-update",
                "body": [
                  {
                    "kind": "message",
                    "from": "api",
                    "to": "cache",
                    "arrow": "sync",
                    "label": "SET order:<id>"
                  },
                  {
                    "kind": "message",
                    "from": "cache",
                    "to": "api",
                    "arrow": "reply",
                    "label": "ok"
                  }
                ]
              },
              {
                "label": "event-publish",
                "body": [
                  {
                    "kind": "message",
                    "from": "api",
                    "to": "queue",
                    "arrow": "sync",
                    "label": "publish OrderPlaced"
                  },
                  {
                    "kind": "message",
                    "from": "queue",
                    "to": "api",
                    "arrow": "reply",
                    "label": "ack"
                  }
                ]
              },
              {
                "label": "analytics",
                "body": [
                  {
                    "kind": "message",
                    "from": "api",
                    "to": "analytics",
                    "arrow": "sync",
                    "label": "track(\\\"order_placed\\\", { orderId })"
                  }
                ]
              }
            ],
            "awaitSpec": {
              "labels": [
                "cache-update",
                "event-publish"
              ]
            }
          },
          {
            "kind": "opt",
            "condition": "userEmail が指定されている場合のみ送信",
            "body": [
              {
                "kind": "message",
                "from": "api",
                "to": "email",
                "arrow": "sync",
                "label": "sendConfirmation(orderId, userEmail)"
              },
              {
                "kind": "message",
                "from": "email",
                "to": "api",
                "arrow": "reply",
                "label": "queued"
              }
            ]
          },
          {
            "kind": "message",
            "from": "api",
            "to": "db",
            "arrow": "sync",
            "label": "update Order (status=PLACED)"
          },
          {
            "kind": "message",
            "from": "db",
            "to": "api",
            "arrow": "reply",
            "label": "ok"
          },
          {
            "kind": "message",
            "from": "api",
            "to": "c",
            "arrow": "reply",
            "label": "201 Created { orderId }"
          }
        ]
      },
