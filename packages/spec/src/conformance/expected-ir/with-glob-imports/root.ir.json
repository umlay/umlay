{
  "version": "1.0",
  "kind": "UmlModel",
  "mode": "strict",
  "specVersion": "1.7.0",
  "meta": {
    "imports": [
      {
        "kind": "path",
        "value": "./tasks/*.umlay"
      }
    ]
  },
  "namespaces": {
    "project_plan": {
      "models": {},
      "types": {},
      "enums": {},
      "events": {},
      "reservedBlocks": [],
      "cloudPrimitives": [],
      "protocols": [],
      "unions": [],
      "impls": [],
      "traits": {}
    }
  },
  "views": [
    {
      "id": "global-gantt",
      "kind": "gantt_chart",
      "include": [
        "sprint1.Task",
        "sprint2.Task",
        "sprint3.Task"
      ],
      "exclude": [],
      "layout": {
        "direction": "LR",
        "engine": "elk",
        "spacing": 20
      },
      "docs": [],
      "attachments": [],
      "participants": [],
      "messages": [],
      "ganttTasks": []
    },
    {
      "id": "global-wbs",
      "kind": "wbs_diagram",
      "include": [
        "sprint1.Task",
        "sprint2.Task",
        "sprint3.Task"
      ],
      "exclude": [],
      "docs": [],
      "attachments": [],
      "participants": [],
      "messages": [],
      "ganttTasks": []
    }
  ]
}
