// saas-multitenant.uml — マルチテナント SaaS
@@mode(strict)

namespace saas

enum Role @intent("組織内の権限レベル") {
  OWNER, ADMIN, MEMBER, GUEST
}

enum InviteStatus @intent("招待状のライフサイクル") {
  PENDING, ACCEPTED, REVOKED, EXPIRED
}

model Organization @aggregate_root @intent("テナント単位の組織") {
  +id   UUID!   @id
  +slug string! @unique
  +name string!
}

model User @aggregate_root @intent("プラットフォーム横断のユーザー") {
  +id    UUID!   @id
  +email string! @unique
  +name  string!
}

model Membership @entity @intent("組織とユーザーの所属関係 (役割付き)") {
  @@id(orgId, userId)
  +orgId  UUID!  @ref(Organization.id, onDelete: CASCADE)
  +userId UUID!  @ref(User.id,         onDelete: CASCADE)
  +role   Role!  @default(MEMBER)
}

model Team @entity @intent("組織内のチーム") {
  +id    UUID!   @id
  +orgId UUID!   @ref(Organization.id, onDelete: CASCADE, inverse: "teams")
  +name  string!

  @@unique(orgId, name)
}

model TeamMember @entity @intent("チームとユーザーの所属関係") {
  @@id(teamId, userId)
  +teamId UUID! @ref(Team.id, onDelete: CASCADE)
  +userId UUID! @ref(User.id, onDelete: CASCADE)
}

model Invitation @entity @intent("メール招待 (受諾 / 失効 / 期限切れ対応)") {
  +id        UUID!          @id
  +orgId     UUID!          @ref(Organization.id, onDelete: CASCADE)
  +email     string!
  +role      Role!          @default(MEMBER)
  +status    InviteStatus!  @default(PENDING)
  +expiresAt Timestamp!

  @@index(orgId, status)
}

view er @er_diagram @intent("マルチテナント SaaS の ER") {
  include: saas.*
}
