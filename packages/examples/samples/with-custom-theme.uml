// with-custom-theme.uml — 外部 CSS テーマ適用デモ (北極星原則 #5)
//
// ファイル先頭の @@theme がファイル全体のデフォルトになる。
// view 単位で @@theme を上書き可能。
@@mode(strict)

@@theme("./themes/brand.css")

namespace shop

model Customer @aggregate_root @intent("購入顧客") {
  +id    UUID!   @id
  +email string! @unique
}

model Product @entity @intent("販売商品") {
  +id    UUID!   @id
  +sku   string! @unique
  +name  string!
  +price decimal!
}

model Order @aggregate_root @intent("顧客の購入注文") {
  +id         UUID! @id
  +customerId UUID! @ref(Customer.id, onDelete: RESTRICT)
}

// プレゼン用のビューだけ別テーマ
view presentation @er_diagram @intent("プレゼン用 ER (別テーマ)") {
  include: shop.*
  @@theme("./themes/presentation.css")
}

view er @er_diagram @intent("通常 ER (ファイル先頭の @@theme を継承)") {
  include: shop.*
}
