// deprecated-migration.umlay — @deprecated アノテーションのデモ (RFC 0023)
//
// spec 0.7.0:
//   - 短縮形: @deprecated("message")
//   - 完全形: @deprecated({ message, since, removeIn, replaceWith })
//   - attribute / model / protocol / enum value / view に適用可能

@@mode(strict)

namespace migrate

// ============================================================================
// 1. attribute 単位の deprecation
// ============================================================================

model User @aggregate_root @intent("ユーザー (移行中の model)") {
  +id       UUID!   @id
  +email    string! @unique
  +username string! @deprecated("use displayName instead since 0.3")       // 短縮形
  +displayName string?

  +fullName string! @deprecated({
    message:     "split into givenName + familyName",
    since:       "0.5.0",
    removeIn:    "1.0.0",
    replaceWith: User.displayName
  })

  +givenName  string?
  +familyName string?
}

// ============================================================================
// 2. model 単位の deprecation
// ============================================================================

model LegacyUser @entity @intent("旧 User モデル、移行完了次第削除")
  @deprecated({
    message:     "migrated to User",
    since:       "0.3.0",
    removeIn:    "1.0.0",
    replaceWith: User
  }) {
  +id UUID! @id
  +email string!
}

// ============================================================================
// 3. protocol 単位の deprecation
// ============================================================================

protocol LegacyRepository<T> @intent("旧 Repository 契約")
  @deprecated({
    message:     "use Repository<T> from core namespace",
    since:       "0.3.0",
    removeIn:    "1.0.0"
  }) {
  fn find(id: UUID!) -> T?
  fn put(entity: T!) -> void
}

// ============================================================================
// 4. enum value の deprecation
// ============================================================================

enum OrderStatus @intent("注文状態") {
  DRAFT,
  CONFIRMED,
  SHIPPED,
  CANCELLED,
  EXPIRED @deprecated("use CANCELLED with reason='expired' instead")
}

// ============================================================================
// 5. view の deprecation
// ============================================================================

view legacy-er @er_diagram @intent("旧 ER、新 migrate-er に移行中")
  @deprecated({
    message:     "use migrate-er which includes new User schema",
    since:       "0.4.0",
    replaceWith: "migrate-er"
  }) {
  include: migrate.LegacyUser
}

view migrate-er @er_diagram @intent("移行後のスキーマ") {
  include: migrate.User
}
