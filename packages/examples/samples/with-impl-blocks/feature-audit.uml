// feature-audit.uml — 監査機能モジュール。core.Auditable を User/Order に適用
//
// spec 0.5.0 (RFC 0016): 同じ target model に複数 protocol を異なるファイルから
// 個別適用できる。ここでは core 所有の protocol を core 所有の model に適用する
// ケース — orphan rule により本来は禁止だが、**core namespace がこの実装を委託
// (delegate)** する宣言を core 側で書けば許可される…というのは将来検討。
//
// 実用上は「auth が所有する protocol」「audit が所有する protocol」を core の
// model に適用するのが主パターン。

@@mode(strict)

namespace audit

import core

// audit 所有の protocol (auth と同じく orphan rule 準拠)
protocol Timestamped @intent("作成/更新時刻を持つ") {
  fn createdAt() -> Timestamp!
  fn updatedAt() -> Timestamp!
}

// where 句で型制約を付けた impl (RFC 0015 + 0016 合わせ技)
impl Timestamped for core.User {
  fn createdAt() -> Timestamp! { }
  fn updatedAt() -> Timestamp! { }
}

impl Timestamped for core.Order {
  fn createdAt() -> Timestamp! { }
  fn updatedAt() -> Timestamp! { }
}
