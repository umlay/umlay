// bounded-generics.umlay — 型パラメータ制約のデモ (RFC 0015)
//
// spec 0.5.0:
//   - `protocol X<T: Foo>` で型制約を宣言
//   - `<T: A & B>` で複数制約 (intersection)
//   - `@@implements(Repository<User>)` 時に User が Identifiable 準拠か検証

@@mode(strict)

namespace demo

// ============================================================================
// 基本 protocol (他の protocol が制約に使う)
// ============================================================================

protocol Identifiable @intent("id を持つ契約") {
  fn getId() -> UUID!
}

protocol Comparable @intent("大小比較可能") {
  fn compareTo(other: Self!) -> int!
    @intent("self < other なら負、等しければ 0、大きければ正")
}

protocol Hashable @intent("hash 可能") {
  fn hash() -> bigint!
}

protocol Serializable<F> @intent("フォーマット F にシリアライズ可能") {
  fn serialize() -> F!
  fn deserialize(data: F!) -> Self!
}

// ============================================================================
// 単一制約
// ============================================================================

protocol Repository<T: Identifiable> @intent("Identifiable な型の永続化") {
  fn get(id: UUID!)  -> T?
  fn save(entity: T!) -> void
  fn delete(id: UUID!) -> bool!
}

// ============================================================================
// 複数制約 (intersection with &)
// ============================================================================

protocol IndexedCache<K: Hashable & Comparable, V> @intent("hash + 順序付きキャッシュ") {
  fn put(k: K!, v: V!) -> void
  fn get(k: K!) -> V?
  fn range(from: K!, to: K!) -> string!
}

// ============================================================================
// 型引数の更に深い制約
// ============================================================================

protocol SortableStore<T: Identifiable & Comparable & Serializable<string>>
  @intent("ソート可能 + ID あり + 文字列シリアライズ可能なストア") {
  fn store(items: T!) -> void
  fn loadSorted() -> T!
}

// ============================================================================
// 実装モデル (制約を満たす具体型)
// ============================================================================

model User @aggregate_root @intent("Identifiable + Comparable 準拠ユーザー") {
  +id       UUID!   @id
  +email    string! @unique
  +username string!

  // 制約準拠: Identifiable
  @@implements(Identifiable)
  @@implements(Comparable)

  fn getId() -> UUID!
    @post("result == id")
    @intent("Identifiable 実装")
  fn compareTo(other: User!) -> int!
    @intent("username で辞書順比較")
}

model UserRepository @service
  @intent("Repository<User> の具象実装。User が Identifiable 準拠なので受理される") {
  @@implements(Repository<User>)
  +id UUID! @id
}
