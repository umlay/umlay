// sprint-3.uml — Sprint 3 のタスク (glob import 対象)

@@mode(strict)

namespace sprint3

enum TaskStatus { PENDING, IN_PROGRESS, DONE }

model Task @aggregate_root @intent("Sprint 3 のタスク") {
  +id           UUID!        @id
  +name         string!
  +plannedStart Date!
  +plannedEnd   Date!
  +progress     decimal!     @default(0.0)
  +status       TaskStatus!  @default(PENDING)
  +assignee     string!

  @@sample(
    { id: "s3-integration", name: "Integration + Hardening",
      plannedStart: "2026-05-25", plannedEnd: "2026-06-05",
      progress: 0.0, status: PENDING, assignee: "Bob" },
    { id: "s3-qa",          name: "QA + Release Prep",
      plannedStart: "2026-06-08", plannedEnd: "2026-06-15",
      progress: 0.0, status: PENDING, assignee: "Carol" },
    { id: "s3-release",     name: "Production Release",
      plannedStart: "2026-06-16", plannedEnd: "2026-06-16",
      progress: 0.0, status: PENDING, assignee: "Alice" }
  )
}
