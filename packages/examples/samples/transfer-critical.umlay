// transfer-critical.umlay — Sequence の `critical` リージョンのデモ (RFC 0017)
//
// spec 0.5.0:
//   - `critical "label" { ... }` で排他実行区間を明示
//   - `on (a, b)` でロック対象の participant を指定
//
// シナリオ: 口座間送金 (A → B)。残高チェックと引落し・入金は
//           分散ロック下のクリティカルセクションで実行する必要がある。

@@mode(strict)

namespace banking

enum AccountStatus { ACTIVE, FROZEN, CLOSED }
enum TxStatus { PENDING, COMMITTED, REVERTED }

model Account @aggregate_root @intent("銀行口座") {
  +id      UUID!          @id
  +owner   string!
  +balance decimal!       @inv("balance >= 0")
  +status  AccountStatus! @default(ACTIVE)
}

model Transfer @aggregate_root @intent("口座間送金トランザクション") {
  +id        UUID!      @id
  +fromId    UUID!      @ref(Account.id)
  +toId      UUID!      @ref(Account.id)
  +amount    decimal!   @inv("amount > 0")
  +status    TxStatus!  @default(PENDING)
  +createdAt Timestamp! @auto
}

// Participant model 群
model API         @service @intent("送金 API")            { +id string! @id }
model LockSvc     @service @intent("分散ロックサービス")   { +id string! @id }
model DB          @service @intent("永続化")              { +id string! @id }
model AccountA    @service @intent("送金元口座アクセサ")   { +id string! @id }
model AccountB    @service @intent("送金先口座アクセサ")   { +id string! @id }
model AuditLog    @service @intent("監査ログ")            { +id string! @id }

// ============================================================================
// Sequence: critical + par + opt の組み合わせ
// ============================================================================

view transfer-flow @sequence_diagram
  @intent("送金フロー。口座残高変更はクリティカル + 監査は並行") {
  participants:
    API      as api,
    LockSvc  as lock,
    DB       as db,
    AccountA as a,
    AccountB as b,
    AuditLog as audit

  seq {
    // 1. ロック取得
    api  ->> lock : "acquire(\"account-pair:{fromId},{toId}\")"
    lock -.> api  : "acquired"

    // 2. クリティカルセクション (RFC 0017)
    //    - 送金元/送金先の残高チェック → 引落し → 入金 → commit
    //    - この区間は他のトランザクションから排他される
    critical "残高チェックと資金移動" on (a, b) {
      api ->> a  : "read balance"
      a   -.> api : "{ balance }"
      api ->> b  : "read balance"
      b   -.> api : "{ balance }"

      alt "残高不足" {
        api -.> lock : "release()"
        api ->> audit : "log(\"transfer rejected: insufficient funds\")"
      } else {
        api ->> a  : "debit(amount)"
        a   -.> api : "ok"
        api ->> b  : "credit(amount)"
        b   -.> api : "ok"
        api ->> db : "commit transaction"
        db  -.> api : "ok"
      }
    }

    // 3. ロック解放 + 並行監査 (RFC 0007 par + RFC 0013 await)
    par "ロック解放" {
      api  ->> lock  : "release()"
      lock -.> api   : "released"
    } and "監査ログ (fire-and-forget)" {
      api ->> audit : "log(\"transfer committed\", { transferId })"
    }
    await ("ロック解放")

    // 4. オプショナル: 閾値超えの場合は通知 (RFC 0007 opt)
    opt "高額送金 (amount > 1000000) の場合" {
      api ->> audit : "notify_compliance_team({ transferId, amount })"
    }

    api -.> a : "200 OK"
  }
}

view account-lifecycle @state_machine
  @intent("AccountStatus の遷移") {
  include: banking.Account, banking.AccountStatus
}
