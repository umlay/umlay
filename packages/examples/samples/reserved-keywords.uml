// reserved-keywords.uml — 予約語の扱い (Phase 1)
//
// spec/src/index.ts の RESERVED_KEYWORDS は Phase 1 パーサが
// **キーワード**として扱う。したがって model 名 / enum 名 / attribute 名
// として使うと parse error になる。
//
// 宣言構文 (例: `function foo { ... }`, `queue bar { ... }`) は grammar に
// まだ存在しないため、Phase 1 では使えない。将来 RFC で段階的に追加予定。

@@mode(strict)

namespace orders

// ============================================================================
// ✅ OK: Phase 1 で描画される宣言 (namespace / type / enum / model / view)
// ============================================================================

model Customer @aggregate_root @intent("購入顧客") {
  +id    UUID!   @id
  +email string! @unique
}

model Order @aggregate_root @intent("顧客発注") {
  +id         UUID!    @id
  +customerId UUID!    @ref(Customer.id, onDelete: RESTRICT, inverse: "orders")
  +total      decimal!
}

view er @er_diagram @intent("orders ドメインの ER") {
  include: orders.Order, orders.Customer
}

// ============================================================================
// ❌ NG: 予約語を identifier として使おうとした例
// (コメントアウト。アンコメントすると Phase 1 パーサが parse error を返す)
// ============================================================================
//
// model function @aggregate_root { +id UUID! @id }        // `function` は予約語
// enum  component { A, B, C }                             // `component` は予約語
// model order @entity { +queue UUID! @id }                // attribute 名 `queue` も NG
//
// --- 完全な予約語リスト (spec/src/index.ts の RESERVED_KEYWORDS) ---
//   v1 実装済み : namespace / type / enum / model / view
//   将来 UML    : protocol / union / fn / module
//   React/Next  : component / page / layout / action / route / context / hook
//   Cloud-native: function / worker / queue / topic / stream / cache / store /
//                 scheduler / webhook / integration / gateway / cdn

// ============================================================================
// 📝 将来追加予定の宣言構文 (RFC 予定、Phase 1 では未対応)
// ============================================================================
//
//   function confirmOrder @lambda {
//     triggers: http POST "/orders/{id}/confirm"
//     input:    { orderId: UUID! }
//     returns:  void
//   }
//
//   queue OrderConfirmRequested @sqs @fifo {
//     message: { orderId: UUID! }
//     dlq:     OrderConfirmDLQ @maxReceive(3)
//   }
//
//   component OrderCard @client {
//     props { order: Order!, onEdit?: (o: Order!) => void }
//     state { isEditing: bool = false }
//   }
//
//   protocol Repository<T> {
//     fn get(id: UUID!)   -> T?
//     fn save(entity: T!) -> void
//   }
//
// → skills/ja/evolve-schema.md の Class A (additive) 相当で段階追加。
