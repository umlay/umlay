// pm-core.umlay — 共通インフラ整備 (全プロジェクト共有)
//
// spec 0.3.0 (RFC 0005 + 0009): cross-namespace @@dependencies + import
// 本ファイルは feature-a / feature-b が共通で参照する core タスク群。

@@mode(strict)

namespace pm_core

enum TaskStatus @intent("タスクの進捗状態") {
  PENDING, IN_PROGRESS, DONE, BLOCKED
}

model Task @aggregate_root
  @intent("core インフラ側のタスク。feature 側から cross-ns で依存される") {
  +id           UUID!        @id
  +name         string!
  +plannedStart Date!
  +plannedEnd   Date!        @inv("plannedEnd >= plannedStart")
  +progress     decimal!     @default(0.0)
  +status       TaskStatus!  @default(PENDING)
  +assignee     string!

  @@sample(
    { id: "c-infra",    name: "Infrastructure Setup",
      plannedStart: "2026-04-20", plannedEnd: "2026-05-03",
      progress: 1.0, status: DONE, assignee: "Eve" },

    { id: "c-auth",     name: "Auth Service (OIDC)",
      plannedStart: "2026-05-04", plannedEnd: "2026-05-17",
      progress: 0.7, status: IN_PROGRESS, assignee: "Frank" },

    { id: "c-db",       name: "Shared DB Schema Baseline",
      plannedStart: "2026-05-04", plannedEnd: "2026-05-10",
      progress: 0.9, status: IN_PROGRESS, assignee: "Eve" }
  )
}

view core-wbs @wbs_diagram { include: pm_core.Task }
view core-gantt @gantt_chart { include: pm_core.Task }
