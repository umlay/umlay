// pm-feature-a.uml — 機能 A のスケジュール (core に依存)
//
// spec 0.3.0:
//   - RFC 0005: `@@dependencies(pm_core.X)` で cross-namespace 先行関係
//   - RFC 0009: `import` による明示的な cross-file 解決

@@mode(strict)

namespace pm_feature_a

// RFC 0009: pm_core を明示 import (暗黙スキャンへの依存を断つ)
import pm_core

enum TaskStatus @intent("...") {
  PENDING, IN_PROGRESS, DONE, BLOCKED
}

model Task @aggregate_root
  @intent("機能 A のタスク。一部タスクは pm_core に依存") {
  +id           UUID!        @id
  +name         string!
  +plannedStart Date!
  +plannedEnd   Date!
  +progress     decimal!     @default(0.0)
  +status       TaskStatus!  @default(PENDING)
  +assignee     string!

  @@sample(
    { id: "a-design",   name: "Feature A Design",
      plannedStart: "2026-05-11", plannedEnd: "2026-05-17",
      progress: 0.5, status: IN_PROGRESS, assignee: "Alice" },

    { id: "a-backend",  name: "Feature A Backend",
      plannedStart: "2026-05-18", plannedEnd: "2026-06-07",
      progress: 0.0, status: PENDING, assignee: "Bob" },

    { id: "a-frontend", name: "Feature A Frontend",
      plannedStart: "2026-05-18", plannedEnd: "2026-06-07",
      progress: 0.0, status: PENDING, assignee: "Dave" },

    { id: "a-release",  name: "Feature A Release",
      plannedStart: "2026-06-10", plannedEnd: "2026-06-10",
      progress: 0.0, status: PENDING, assignee: "Alice" }
  )
}

// Cross-namespace 先行関係 (RFC 0005)
//   a-design    は pm_core.Task (c-auth) の完了後に開始
//   a-backend   は pm_core.Task (c-db / c-auth) に加えて a-design を先行にする
//
// ※ TaskDependency エンティティを使った典型パターン

model TaskDependency @entity
  @intent("feature A 内の先行関係 (cross-ns の on を許容)") {
  @@id(fromId, toId)
  +fromId UUID! @ref(Task.id, onDelete: CASCADE)
  +toId   UUID! @ref(Task.id, onDelete: CASCADE)
  +kind   string! @default("FS")
  +lag    int!    @default(0)

  @@sample(
    // 内部依存
    { fromId: "a-design",   toId: "a-backend" },
    { fromId: "a-design",   toId: "a-frontend" },
    { fromId: "a-backend",  toId: "a-release" },
    { fromId: "a-frontend", toId: "a-release" }
  )
}

// model-level で cross-ns dep を宣言するパターン (RFC 0005)
// 「この model の a-design インスタンスは pm_core.c-auth に依存する」
// を表現する代替手段 (model カテゴリ単位の宣言)。実際の runtime では
// TaskDependency 行と合算される。
model FeatureACoreDependency @entity
  @intent("cross-namespace の代表依存 (pm_core.Task → Feature A)") {
  @@dependencies(pm_core.Task)                                   /* 短縮形 */
  @@dependencies({ on: pm_core.Task, kind: FS, lag: 1 })         /* 完全形 */
  +id UUID! @id
}

view feature-a-wbs @wbs_diagram { include: pm_feature_a.Task }
view feature-a-gantt @gantt_chart {
  include: pm_feature_a.Task, pm_feature_a.TaskDependency
}
