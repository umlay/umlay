// pm-feature-b.umlay — 機能 B のスケジュール (core + feature A に依存)
//
// spec 0.3.0:
//   - RFC 0005: 複数の namespace を跨ぐ依存
//   - RFC 0009: `import` による明示的な cross-file 解決

@@mode(strict)

namespace pm_feature_b

// RFC 0009: 2 つの外部 namespace を明示 import
import pm_core
import pm_feature_a

enum TaskStatus @intent("...") {
  PENDING, IN_PROGRESS, DONE, BLOCKED
}

model Task @aggregate_root
  @intent("機能 B のタスク。pm_core + pm_feature_a に依存") {
  +id           UUID!        @id
  +name         string!
  +plannedStart Date!
  +plannedEnd   Date!
  +progress     decimal!     @default(0.0)
  +status       TaskStatus!  @default(PENDING)
  +assignee     string!

  @@sample(
    { id: "b-design",   name: "Feature B Design",
      plannedStart: "2026-05-25", plannedEnd: "2026-05-31",
      progress: 0.2, status: IN_PROGRESS, assignee: "Grace" },

    { id: "b-impl",     name: "Feature B Implementation",
      plannedStart: "2026-06-01", plannedEnd: "2026-06-21",
      progress: 0.0, status: PENDING, assignee: "Heidi" },

    { id: "b-release",  name: "Feature B Release",
      plannedStart: "2026-06-25", plannedEnd: "2026-06-25",
      progress: 0.0, status: PENDING, assignee: "Grace" }
  )
}

// 内部依存
model TaskDependency @entity
  @intent("feature B 内の先行関係") {
  @@id(fromId, toId)
  +fromId UUID! @ref(Task.id, onDelete: CASCADE)
  +toId   UUID! @ref(Task.id, onDelete: CASCADE)

  @@sample(
    { fromId: "b-design", toId: "b-impl" },
    { fromId: "b-impl",   toId: "b-release" }
  )
}

// Cross-namespace 依存 (RFC 0005): pm_core + pm_feature_a を両方参照
model FeatureBCrossDeps @entity
  @intent("feature B は core のインフラと feature A の完了に依存") {
  @@dependencies(
    { on: pm_core.Task,       kind: FS, lag: 0 },   /* core インフラ */
    { on: pm_feature_a.Task,  kind: FS, lag: 3 }    /* A の 3 日後に B 開始 */
  )
  +id UUID! @id
}

view feature-b-wbs @wbs_diagram { include: pm_feature_b.Task }
view feature-b-gantt @gantt_chart {
  include: pm_feature_b.Task, pm_feature_b.TaskDependency
}
