// variance-demo.umlay — 型パラメータ variance のデモ (RFC 0019)
//
// spec 0.6.0:
//   - `<out T>` 共変: T は return / read-only 位置のみ
//   - `<in T>`  反変: T は parameter 位置のみ
//   - 省略時: 不変 (invariant)

@@mode(strict)

namespace variance_demo

// ============================================================================
// 基盤: サブタイプ関係を持つ型 (Animal / Dog / Cat)
// ============================================================================

protocol Animal @intent("動物の共通契約") {
  fn getName() -> string!
}

protocol Dog extends Animal @intent("犬は動物のサブタイプ") {
  fn bark() -> void
}

protocol Cat extends Animal @intent("猫は動物のサブタイプ") {
  fn meow() -> void
}

// ============================================================================
// 共変 Producer<out T>: T は return 位置のみ
// ============================================================================

protocol Producer<out T> @intent("T を生産する。共変なので Producer<Dog> <: Producer<Animal>") {
  fn produce()  -> T!
  fn produceOrNull() -> T?
  // fn accept(x: T!) -> void   ← NG: in 位置で使うと parse error
}

// ============================================================================
// 反変 Consumer<in T>: T は parameter 位置のみ
// ============================================================================

protocol Consumer<in T> @intent("T を消費する。反変なので Consumer<Animal> <: Consumer<Dog>") {
  fn consume(item: T!)      -> void
  fn consumeMany(items: T!) -> void
  // fn get() -> T!           ← NG: out 位置で使うと parse error
}

// ============================================================================
// 混合 Collection<out R, in W>: 読みは共変、書きは反変
// ============================================================================

protocol Collection<out R, in W> @intent("読み T 共変 / 書き W 反変の収集器") {
  fn read()           -> R?
  fn write(item: W!)  -> void
}

// ============================================================================
// 不変 Repository<T>: 従来通り (variance 未指定)
// ============================================================================

protocol Repository<T> @intent("不変なので Repository<Dog> と Repository<Animal> は無関係") {
  fn get(id: UUID!)    -> T?
  fn save(entity: T!)  -> void
}

// ============================================================================
// 実装例 (variance の恩恵)
// ============================================================================

model DogProducer @service @intent("Dog を生産。Producer<Animal> としても扱える (共変)") {
  @@implements(Producer<Dog>)
  +id UUID! @id
}

model AnimalConsumer @service @intent("Animal を消費。Consumer<Dog> としても扱える (反変)") {
  @@implements(Consumer<Animal>)
  +id UUID! @id
}

view variance-class @class_diagram @intent("variance 付き protocol の継承関係") {
  include: variance_demo.*
  layout: direction(TB), engine(elk)
}
