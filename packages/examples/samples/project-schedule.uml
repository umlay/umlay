// project-schedule.uml — 新機能リリース計画の Gantt / WBS
//
// spec 0.3.0: @@sample(...) (RFC 0004) でインスタンスデータを表現する
// 「正しい」方式。生成された Task 行は Gantt の各バーに、
// TaskDependency 行は矢印に、Resource 行は担当者リストに対応。
//
// 構成: Resource 4 名、Task 13 件 (親 3 + 子 8 + マイルストーン 2)、
//       TaskDependency 11 件 (linear dependency + Integration の多重依存)

@@mode(strict)

namespace pm

enum TaskStatus @intent("タスクの進捗状態") {
  PENDING, IN_PROGRESS, DONE, BLOCKED
}

enum Priority @intent("タスクの優先度") {
  LOW, MEDIUM, HIGH, CRITICAL
}

enum DependencyKind @intent("PMBOK 準拠の依存関係種別") {
  FS, SS, FF, SF
}

// ============================================================================
// Resource (担当者プール)
// ============================================================================

model Resource @aggregate_root
  @intent("プロジェクトメンバー。Task.assigneeId の参照先") {
  +id       UUID!    @id
  +name     string!
  +role     string!
  +email    string!  @unique
  +capacity decimal! @default(1.0)
                    @inv("capacity > 0 && capacity <= 1.0")
  +active   bool!    @default(true)

  @@sample(
    { id: "r-alice", name: "Alice", role: "Project Manager",
      email: "alice@example.com", capacity: 1.0 },
    { id: "r-bob",   name: "Bob",   role: "Backend Engineer",
      email: "bob@example.com",   capacity: 1.0 },
    { id: "r-carol", name: "Carol", role: "QA Engineer",
      email: "carol@example.com", capacity: 0.8 },
    { id: "r-dave",  name: "Dave",  role: "Frontend Engineer",
      email: "dave@example.com",  capacity: 1.0 }
  )
}

// ============================================================================
// Task (WBS / Gantt のタスク本体)
// ============================================================================

model Task @aggregate_root
  @intent("WBS の最小作業単位 / Gantt のバー 1 本に対応") {
  +id          UUID!         @id
  +name        string!
  +description string?

  // --- スケジュール ---
  +plannedStart Date!
  +plannedEnd   Date!         @inv("plannedEnd >= plannedStart")
  +actualStart  Date?
  +actualEnd    Date?
  +progress     decimal!      @default(0.0)
                              @inv("progress >= 0.0 && progress <= 1.0")

  // --- 分類 ---
  +status       TaskStatus!   @default(PENDING)
  +priority     Priority!     @default(MEDIUM)
  +isMilestone  bool!         @default(false)

  // --- 担当者 (任意、Resource 削除時は担当なしに降格) ---
  +assigneeId   UUID?         @ref(Resource.id,
                                   onDelete: SET_NULL,
                                   inverse: "assignedTasks")

  // --- WBS 階層: 自己参照 (NULL ならルート) ---
  +parentId     UUID?         @ref(Task.id,
                                   onDelete: CASCADE,
                                   inverse: "children")

  @@index(parentId)
  @@index(assigneeId)
  @@index(status)

  // ========== 具体タスク 13 件 (RFC 0004: @@sample) ==========
  @@sample(
    // --- マイルストーン ---
    { id: "t-kickoff", name: "Kickoff",
      plannedStart: "2026-04-20", plannedEnd: "2026-04-20",
      progress: 1.0, status: DONE, priority: CRITICAL,
      assigneeId: "r-alice", isMilestone: true },

    { id: "t-release", name: "Release",
      plannedStart: "2026-06-30", plannedEnd: "2026-06-30",
      progress: 0.0, status: PENDING, priority: CRITICAL,
      assigneeId: "r-alice", isMilestone: true },

    // --- 親タスク (Summary bars) ---
    { id: "t-planning", name: "Planning Phase",
      plannedStart: "2026-04-20", plannedEnd: "2026-05-03",
      progress: 1.0, status: DONE, priority: HIGH,
      assigneeId: "r-alice" },

    { id: "t-build", name: "Build Phase",
      plannedStart: "2026-05-04", plannedEnd: "2026-06-15",
      progress: 0.60, status: IN_PROGRESS, priority: HIGH,
      assigneeId: "r-bob" },

    { id: "t-testing", name: "Testing Phase",
      plannedStart: "2026-06-16", plannedEnd: "2026-06-29",
      progress: 0.0, status: PENDING, priority: HIGH,
      assigneeId: "r-carol" },

    // --- Planning の子 ---
    { id: "t-discovery", name: "Discovery",
      plannedStart: "2026-04-20", plannedEnd: "2026-04-25",
      progress: 1.0, status: DONE, priority: HIGH,
      assigneeId: "r-alice", parentId: "t-planning" },

    { id: "t-reqdef", name: "Requirements Definition",
      plannedStart: "2026-04-26", plannedEnd: "2026-04-30",
      progress: 1.0, status: DONE, priority: HIGH,
      assigneeId: "r-bob", parentId: "t-planning" },

    { id: "t-estimate", name: "Estimation",
      plannedStart: "2026-05-01", plannedEnd: "2026-05-03",
      progress: 1.0, status: DONE, priority: MEDIUM,
      assigneeId: "r-alice", parentId: "t-planning" },

    // --- Build の子 ---
    { id: "t-backend", name: "Backend Development",
      plannedStart: "2026-05-04", plannedEnd: "2026-05-24",
      progress: 0.80, status: IN_PROGRESS, priority: HIGH,
      assigneeId: "r-bob", parentId: "t-build" },

    { id: "t-frontend", name: "Frontend Development",
      plannedStart: "2026-05-11", plannedEnd: "2026-06-07",
      progress: 0.50, status: IN_PROGRESS, priority: HIGH,
      assigneeId: "r-dave", parentId: "t-build" },

    { id: "t-integration", name: "Integration",
      plannedStart: "2026-06-08", plannedEnd: "2026-06-15",
      progress: 0.0, status: PENDING, priority: HIGH,
      assigneeId: "r-bob", parentId: "t-build" },

    // --- Testing の子 ---
    { id: "t-unit", name: "Unit Testing",
      plannedStart: "2026-06-16", plannedEnd: "2026-06-20",
      progress: 0.0, status: PENDING, priority: MEDIUM,
      assigneeId: "r-carol", parentId: "t-testing" },

    { id: "t-e2e", name: "E2E + UAT",
      plannedStart: "2026-06-21", plannedEnd: "2026-06-29",
      progress: 0.0, status: PENDING, priority: HIGH,
      assigneeId: "r-carol", parentId: "t-testing" }
  )
}

// ============================================================================
// TaskDependency (Gantt の矢印)
// ============================================================================

model TaskDependency @entity
  @intent("Task 間の先行関係。Gantt の矢印 1 本に対応") {
  @@id(fromTaskId, toTaskId)

  +fromTaskId UUID!            @ref(Task.id,
                                    onDelete: CASCADE,
                                    inverse: "successors")
  +toTaskId   UUID!            @ref(Task.id,
                                    onDelete: CASCADE,
                                    inverse: "predecessors")
  +kind       DependencyKind!  @default(FS)
  +lagDays    int!             @default(0)
                               @inv("lagDays >= -60 && lagDays <= 365")

  // ========== 11 件の依存関係 ==========
  @@sample(
    // メインライン
    { fromTaskId: "t-kickoff",   toTaskId: "t-discovery"   },
    { fromTaskId: "t-discovery", toTaskId: "t-reqdef"      },
    { fromTaskId: "t-reqdef",    toTaskId: "t-estimate"    },
    { fromTaskId: "t-estimate",  toTaskId: "t-backend"     },
    { fromTaskId: "t-estimate",  toTaskId: "t-frontend"    },
    // Integration は Backend + Frontend 両方が先行 (多重依存)
    { fromTaskId: "t-backend",   toTaskId: "t-integration" },
    { fromTaskId: "t-frontend",  toTaskId: "t-integration" },
    // Testing 以降
    { fromTaskId: "t-integration", toTaskId: "t-unit" },
    { fromTaskId: "t-unit",        toTaskId: "t-e2e"  },
    // Release (2 日の lag を挟む)
    { fromTaskId: "t-e2e",         toTaskId: "t-release", kind: FS, lag: 2 }
  )
}

// ============================================================================
// Views
// ============================================================================

view pm-wbs @wbs_diagram
  @intent("タスク階層 (parentId ツリー)") {
  include: pm.Task
  layout: direction(TB), engine(elk)
}

view pm-gantt @gantt_chart
  @intent("10 週間の Gantt。バー=Task、矢印=TaskDependency") {
  include: pm.Task, pm.TaskDependency
  layout: direction(LR), engine(elk), spacing(24)
}

view pm-er @er_diagram
  @intent("永続化スキーマ (Resource / Task / TaskDependency)") {
  include: pm.Resource, pm.Task, pm.TaskDependency
}

view pm-class @class_diagram
  @intent("ドメイン構造") {
  include: pm.Resource, pm.Task, pm.TaskDependency,
           pm.TaskStatus, pm.Priority, pm.DependencyKind
}

view task-lifecycle @state_machine
  @intent("TaskStatus の遷移: PENDING → IN_PROGRESS → DONE / BLOCKED") {
  include: pm.Task, pm.TaskStatus
}
