{
  "name": "tree-sitter-umlay",
  "version": "0.1.0",
  "description": "tree-sitter grammar for the Umlay DSL. Powers GitHub syntax highlighting and editors that use tree-sitter (Neovim, Zed, Helix).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/umlay/umlay.git",
    "directory": "packages/tree-sitter-umlay"
  },
  "keywords": ["umlay", "parser", "tree-sitter", "dsl", "uml"],
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "queries/*.scm",
    "src/*.c",
    "src/*.h",
    "src/tree_sitter/*.h",
    "bindings/node/*"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "build": "tree-sitter generate && node-gyp configure && node-gyp build",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.umlay",
      "file-types": ["umlay"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  }
}
